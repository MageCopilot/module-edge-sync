<script>
require(['jquery'], function($) {
    'use strict';
    var container = $('#magecopilot-sync-inspector');
    if (!container.length) return;

    var productId = container.data('product-id');
    var syncUrl = container.data('sync-url');
    var previewUrl = container.data('preview-url');

    var textNone = '<?= $escaper->escapeJs(__('None')) ?>';
    var textInStock = '<?= $escaper->escapeJs(__('In Stock')) ?>';
    var textOutOfStock = '<?= $escaper->escapeJs(__('Out of Stock')) ?>';
    var textNotIndexed = '<?= $escaper->escapeJs(__('Not indexed')) ?>';
    var textInMemory = '<?= $escaper->escapeJs(__('In Memory')) ?>';
    var textOutOfSync = '<?= $escaper->escapeJs(__('Out of Sync')) ?>';
    var textActiveCache = '<?= $escaper->escapeJs(__('HIT (Active Cache)')) ?>';
    var textPurgeSuccess = '<?= $escaper->escapeJs(__('Surgical purge completed successfully (<800ms)')) ?>';
    var textInspectError = '<?= $escaper->escapeJs(__('Error inspecting sync status')) ?>';
    var textSyncError = '<?= $escaper->escapeJs(__('Communication error with SurgicalSync: ')) ?>';
    var textPreviewFail = '<?= $escaper->escapeJs(__('Could not generate opaque preview token')) ?>';
    var textPreviewError = '<?= $escaper->escapeJs(__('Error invoking GeneratePreviewToken')) ?>';

    function showToast(msg, isSuccess) {
        var toast = $('#mc-sync-toast');
        toast.removeClass('mc-toast-success mc-toast-error')
            .addClass(isSuccess ? 'mc-toast-success' : 'mc-toast-error')
            .text(msg)
            .fadeIn(200);
        setTimeout(function() { toast.fadeOut(400); }, 5000);
    }

    function updateUi(data) {
        if (!data || !data.success) {
            showToast(data.error || textInspectError, false);
            return;
        }

        // MariaDB
        if (data.mariadb) {
            $('#mc-db-price').text('$' + Number(data.mariadb.price || 0).toFixed(2));
            $('#mc-db-special-price').text(data.mariadb.special_price ? '$' + Number(data.mariadb.special_price).toFixed(2) : textNone);
            $('#mc-db-stock').text((data.mariadb.stock_qty || 0) + ' units (' + (data.mariadb.is_in_stock ? textInStock : textOutOfStock) + ')');
            $('#mc-db-updated').text(data.mariadb.updated_at || '-');
        }

        // Typesense
        if (data.typesense) {
            $('#mc-ts-price').text(data.typesense.price ? '$' + Number(data.typesense.price).toFixed(2) : textNotIndexed);
            $('#mc-ts-stock').text((data.typesense.stock_qty || 0) + ' units (' + (data.typesense.is_in_stock ? textInStock : textOutOfStock) + ')');
            $('#mc-ts-latency').text(data.typesense.latency_ms + ' ms');
            $('#mc-ts-col').text(data.typesense.collection || 'products');
            if (data.typesense.synced) {
                $('#mc-ts-status-pill').removeClass('mc-status-miss').addClass('mc-status-hit').text(textInMemory);
            } else {
                $('#mc-ts-status-pill').removeClass('mc-status-hit').addClass('mc-status-miss').text(textOutOfSync);
            }
        }

        // Cloudflare
        if (data.cloudflare) {
            $('#mc-cf-status').text(data.cloudflare.status || 'HIT');
            $('#mc-cf-pop').text(data.cloudflare.edge_pop || 'Global');
            $('#mc-cf-age').text((data.cloudflare.age_seconds || 0) + ' s');
            $('#mc-cf-tag').text(data.cloudflare.cache_tag || ('product_' + productId));
            if (data.cloudflare.status === 'HIT') {
                $('#mc-cf-status-pill').removeClass('mc-status-miss').addClass('mc-status-hit').text(textActiveCache);
            } else {
                $('#mc-cf-status-pill').removeClass('mc-status-hit').addClass('mc-status-miss').text(data.cloudflare.status);
            }
        }
    }

    function executeSync(action) {
        var isPurge = (action === 'purge_sync');
        var btn = isPurge ? $('#mc-btn-purge') : $('#mc-btn-inspect');
        btn.prop('disabled', true);

        $.ajax({
            url: syncUrl,
            type: 'POST',
            dataType: 'json',
            data: {
                product_id: productId,
                action: action,
                form_key: window.FORM_KEY
            },
            success: function(resp) {
                btn.prop('disabled', false);
                updateUi(resp);
                if (isPurge && resp.success) {
                    showToast(resp.message || textPurgeSuccess, true);
                }
            },
            error: function(xhr) {
                btn.prop('disabled', false);
                showToast(textSyncError + (xhr.statusText || 'Error'), false);
            }
        });
    }

    // Handlers
    $('#mc-btn-inspect').on('click', function() { executeSync('inspect'); });
    $('#mc-btn-purge').on('click', function() { executeSync('purge_sync'); });

    $('#mc-btn-preview').on('click', function() {
        var btn = $(this);
        btn.prop('disabled', true);
        $.ajax({
            url: previewUrl,
            type: 'POST',
            dataType: 'json',
            data: {
                product_id: productId,
                form_key: window.FORM_KEY
            },
            success: function(resp) {
                btn.prop('disabled', false);
                if (resp.success && resp.preview_url) {
                    window.open(resp.preview_url, '_blank');
                } else {
                    showToast(resp.error || textPreviewFail, false);
                }
            },
            error: function() {
                btn.prop('disabled', false);
                showToast(textPreviewError, false);
            }
        });
    });

    // Initial inspection on page load
    executeSync('inspect');
});
</script>
