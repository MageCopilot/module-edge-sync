<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magecopilot" translate="label" sortOrder="500">
            <label>MageCopilot</label>
        </tab>
        <section id="magecopilot_edgesync" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>EdgeSync (Typesense Engine)</label>
            <tab>magecopilot</tab>
            <resource>MageCopilot_EdgeSync::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Typesense Cluster Connection</label>

                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable EdgeSync</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable continuous catalog and inventory replication into Typesense RAM.</comment>
                </field>

                <field id="typesense_host" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Typesense Host URL</label>
                    <comment>Cluster URL (e.g. http://127.0.0.1:8108 or Typesense Cloud URL).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="typesense_api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Typesense Admin API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Admin API key with write access for catalog indexing. Encrypted in database.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="collection_name" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Catalog Collection Name</label>
                    <comment>Target collection name in Typesense. Default: products.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="batch_size" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Batch Size</label>
                    <comment>Number of products indexed per HTTP JSONL chunk. Default: 250.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="embedding" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Semantic Search Vector Embeddings</label>

                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Embeddings</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Generate vector embeddings for hybrid/semantic search.</comment>
                </field>

                <field id="provider" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Embedding Provider</label>
                    <comment>Vector model provider (deterministic, openai, gemini).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>API key for vector provider (OpenAI / Gemini). Encrypted in database.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="model" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Embedding Model</label>
                    <comment>Embedding model identifier (e.g. text-embedding-3-small).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="dimensions" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Vector Dimensions</label>
                    <comment>Vector length (default 512 for Typesense schema).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>

