<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="magecopilot_typesense_index" xsi:type="object">MageCopilot\EdgeSync\Console\Command\IndexCommand</item>
                <item name="magecopilot_seed_catalog" xsi:type="object">MageCopilot\EdgeSync\Console\Command\SeedCatalogCommand</item>
                <item name="magecopilot_test_stock_sync" xsi:type="object">MageCopilot\EdgeSync\Console\Command\TestStockSyncCommand</item>
                <item name="magecopilot_sku_charset_report" xsi:type="object">MageCopilot\EdgeSync\Console\Command\SkuCharsetReportCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Plugin to capture MSI stock reservations on order placement -->
    <type name="Magento\InventorySalesApi\Api\PlaceReservationsForSalesEventInterface">
        <plugin name="magecopilot_inventory_reservation_sync_plugin"
                type="MageCopilot\EdgeSync\Plugin\InventoryReservationSyncPlugin"
                sortOrder="100"/>
    </type>
</config>
