<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * MageCopilot - Edge-First Headless Storefront Engine
 *
 * PHPUnit configuration for MageCopilot_EdgeSync unit tests.
 * Run from Magento root: vendor/bin/phpunit -c app/code/MageCopilot/EdgeSync/phpunit.xml
 */
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="../../../../dev/tests/unit/framework/bootstrap.php"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         colors="true">

    <testsuites>
        <testsuite name="MageCopilot_EdgeSync Unit Tests">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">.</directory>
        </include>
        <exclude>
            <directory>Test</directory>
        </exclude>
    </source>

    <php>
        <ini name="memory_limit" value="512M"/>
        <ini name="error_reporting" value="E_ALL"/>
    </php>
</phpunit>
